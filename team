<style>
:root{
  --ink:#16332B; --pine:#3A6B58; --paper:#FFFFFF; --wash:#EDF1EA;
  --marker:#EE3A6B; --tan:#C79355; --rule:#CBD8CE;
  --display:'Bricolage Grotesque',Georgia,serif;
  --body:'Instrument Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --gut:clamp(1.25rem,5vw,5rem); --max:72rem;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;overflow-x:clip}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);
  font-size:clamp(1rem,.96rem + .25vw,1.125rem);line-height:1.6;
  -webkit-font-smoothing:antialiased;overflow-x:clip}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{max-width:var(--max);margin:0 auto;padding-inline:var(--gut)}

h1,h2,h3{font-family:var(--display);font-weight:800;line-height:1.03;letter-spacing:-.025em;margin:0}
h1{font-size:clamp(2.2rem,1.1rem + 4.4vw,4rem);overflow-wrap:break-word}
h2{font-size:clamp(1.6rem,1.1rem + 2vw,2.4rem)}
p{margin:0 0 1.1em}
.lede{font-size:clamp(1.05rem,1rem + .45vw,1.3rem);line-height:1.5;max-width:36em;color:var(--pine)}

.top{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.93);
  backdrop-filter:saturate(140%) blur(8px);border-bottom:1px solid var(--rule)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:4.25rem}
.mark{font-family:var(--display);font-weight:800;font-size:1.3rem;letter-spacing:-.03em;
  text-decoration:none;display:flex;align-items:baseline;gap:.14em}
.mark i{width:.34em;height:.34em;border-radius:50%;background:var(--marker);display:inline-block;font-style:normal}
.top nav{display:flex;gap:1.6rem;font-size:.94rem;font-weight:500}
.top nav a{text-decoration:none;color:var(--pine)}
.top nav a:hover{color:var(--marker)}
.top nav a[aria-current="page"]{color:var(--ink);text-decoration:underline;text-underline-offset:5px;text-decoration-color:var(--marker);text-decoration-thickness:2px}
@media(max-width:48rem){.top nav{display:none}}

.page-head{padding:clamp(3rem,6vw,5rem) 0 clamp(2rem,4vw,3rem)}
.page-head h1{max-width:18ch}
.page-head .lede{margin-top:1.35rem}

section{padding:clamp(2.5rem,5vw,4rem) 0}
.band{background:var(--wash)}
.section-head{max-width:36em;margin-bottom:clamp(1.75rem,3.5vw,2.5rem)}
.section-head p{margin-top:.9rem;color:var(--pine)}

/* lead */
.lead-card{display:grid;grid-template-columns:auto 1fr;gap:clamp(1rem,3vw,2rem);align-items:baseline;
  border-top:3px solid var(--marker);padding-top:1.5rem;max-width:46rem}
.lead-card>*{min-width:0}
.lead-card .who{font-family:var(--display);font-weight:800;font-size:clamp(1.5rem,1.2rem + 1.2vw,2rem);letter-spacing:-.03em;white-space:nowrap}
.lead-card .role{color:var(--pine);margin:0}
@media(max-width:40rem){.lead-card{grid-template-columns:1fr;gap:.4rem}.lead-card .who{white-space:normal}}

/* board roster */
.roster{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:0 clamp(1.5rem,3vw,2.5rem)}
@media(max-width:52rem){.roster{grid-template-columns:repeat(2,1fr)}}
@media(max-width:34rem){.roster{grid-template-columns:1fr}}
.roster li{min-width:0;border-top:1px solid var(--rule);padding:1.1rem 0}
.roster b{display:block;font-family:var(--display);font-weight:600;font-size:1.1rem;letter-spacing:-.01em}
.roster span{display:block;margin-top:.25rem;font-size:.92rem;color:var(--pine);line-height:1.4}

/* club leaders */
.leaders{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.7rem}
.leaders li{border:2px solid var(--ink);border-radius:100px;padding:.5rem 1.15rem;
  font-family:var(--display);font-weight:600;font-size:1.05rem;letter-spacing:-.01em}

.thanks{max-width:38em;color:var(--pine);border-left:3px solid var(--tan);padding-left:1.25rem}

.actions{display:flex;flex-wrap:wrap;gap:.85rem;margin-top:1.75rem}
.btn{display:inline-block;text-decoration:none;font-weight:600;font-size:.98rem;
  padding:.8rem 1.4rem;border-radius:100px;border:2px solid var(--ink);
  background:var(--ink);color:var(--paper);transition:background .15s,color .15s,border-color .15s}
.btn:hover{background:var(--marker);border-color:var(--marker)}
.btn.ghost{background:none;color:var(--ink)}
.btn.ghost:hover{background:var(--ink);color:var(--paper)}
a:focus-visible,.btn:focus-visible{outline:3px solid var(--marker);outline-offset:3px;border-radius:3px}

footer{border-top:1px solid var(--rule);padding:2.5rem 0 3.5rem;font-size:.92rem;color:var(--pine)}
.foot{display:flex;flex-wrap:wrap;gap:1.5rem 2.5rem;justify-content:space-between;align-items:start}
footer a{color:var(--pine)}
footer a:hover{color:var(--marker)}
.fine{margin-top:2rem;font-size:.82rem;color:#7E9A8C}
</style>
</head>
